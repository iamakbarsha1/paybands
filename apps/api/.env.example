# Copy to .env and fill in. Never commit a real connection string.
# Neon gives both URLs in the console; the direct one is the same host
# without `-pooler`.

# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/paybands?sslmode=require"

# Direct connection, used by `prisma migrate`. Migrations take advisory locks
# and build a shadow database, neither of which belongs on a pooled connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/paybands?sslmode=require"

# Signs the session cookie. At least 32 characters, and not this one:
# `openssl rand -base64 32`. Changing it signs every live session out.
SESSION_SECRET="generate-your-own-at-least-32-characters"
